# Зависимости
node_modules/

# Заявки абонентов и приложенные ими файлы — персональные данные.
# В репозитории им не место: 152-ФЗ, и это рабочие данные, а не код.
server/data/*.ndjson
server/uploads/*
!server/uploads/.gitkeep

# Локальные настройки и логи
.env
*.log
npm-debug.log*

# Системное
Thumbs.db
Desktop.ini
.DS_Store

# Исходные постраничные сканы: те же страницы уже собраны в 4 PDF рядом.
# 15 МБ дубликатов в истории git не нужны, файлы остаются локально.
public/docs/_scans/
