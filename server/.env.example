# Скопируйте этот файл в .env и заполните перед боевым запуском.
# .env не должен попадать в git — он уже в .gitignore.

PORT=3000
HOST=0.0.0.0

# Логин и пароль панели управления (/admin).
# Если ADMIN_PASS не задан, сервер сам сгенерирует временный пароль
# и покажет его в консоли при запуске — но он новый при каждом перезапуске,
# поэтому для боевого сервера пароль нужно задать здесь явно.
ADMIN_USER=admin
ADMIN_PASS=

# Ключ для программы начислений «Теплобиллинг»: по нему программа раз в 10 минут
# забирает новые показания счётчиков (GET /api/billing/readings) и отмечает,
# приняты они или отклонены. Длинная случайная строка, например: openssl rand -hex 32.
# Тот же ключ вписывается в программу (SITE_READINGS_TOKEN). Пусто — связь выключена.
BILLING_TOKEN=

# Ключ подписи примера «я человек» в формах сайта (показания, обращения, договор).
# Длинная случайная строка, например: openssl rand -hex 32. Никому не передаётся.
# Если не задан — сервер берёт случайный ключ на одно включение и пишет предупреждение
# в журнал: примеры, выданные до перезапуска, после него не примутся.
FORM_CHECK_SECRET=

# Лимиты заявок за сутки (необязательно; пусто — 3 и 10):
# заявок с показаниями на один лицевой счёт и заявок всех видов с одного адреса.
# FORM_LIMIT_ACCOUNT_DAY=3
# FORM_LIMIT_IP_DAY=10
