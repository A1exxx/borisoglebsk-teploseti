# Зависимости
node_modules/

# Заявки абонентов и приложенные ими файлы — персональные данные.
# В репозитории им не место: 152-ФЗ, и это рабочие данные, а не код.
server/data/*.ndjson

# Телефоны и документы, добавленные в панели на рабочем сервере, — это живые
# данные предприятия, а не код: в репозиторий они не попадают, иначе следующая
# выкладка затрёт то, что вписали в панели.
server/data/contacts.json
server/data/docs.json
server/data/docs/
server/uploads/*
!server/uploads/.gitkeep

# Локальные настройки и логи
.env
*.log
npm-debug.log*

# Системное
Thumbs.db
Desktop.ini
.DS_Store

# Исходные постраничные сканы: те же страницы уже собраны в 4 PDF рядом.
# 15 МБ дубликатов в истории git не нужны, файлы остаются локально.
public/docs/_scans/

# Демо-сборка для GitHub Pages (tools/build-demo.js)
.demo/

# Исходники документов для публикации — хранятся в проекте, не в репозитории сайта
приказ/

# Картинки объявлений, загруженные сотрудником в панели, — живые данные сайта
server/data/news/

# Исходники типовых документов чужой организации: переделанные копии лежат
# в public/docs/tipovye, исходники остаются локально
доки/
